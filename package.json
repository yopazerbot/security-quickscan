{
  "name": "security-quickscan",
  "private": true,
  "type": "module",
  "description": "Read-only security quick scans of Microsoft 365 / Entra ID, Azure, AWS and GitHub, evaluated against ISO/IEC 27001:2022 Annex A.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yopazerbot/security-quickscan.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @qs/server & npm run dev -w @qs/web",
    "build": "npm run build -w @qs/web && npm run build -w @qs/server",
    "start": "node apps/server/dist/main.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @qs/server",
    "db:generate": "npm run db:generate -w @qs/server",
    "e2e": "playwright test",
    "docs:checks": "tsx scripts/gen-checks-doc.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
