# Quickest start on your own machine: set LOCAL_MODE=true and DATABASE_URL, leave the rest empty.
# Local mode has no login, only answers on localhost and generates its own MASTER_KEY (.data/master.key).
LOCAL_MODE=false

# ---- Core ----
# Hosted: public URL. Local mode: leave empty (defaults to http://localhost:8080).
APP_URL=
DATABASE_URL=postgres://user:pass@host:5432/db
# Railway Postgres over the private network does not need TLS; set true for external databases.
DATABASE_SSL=false
# 32 random bytes, base64:  node apps/server/dist/cli.js gen-master-key   (or: openssl rand -base64 32)
# Store it in Railway variables only. Losing it makes stored credentials unreadable (they are short-lived anyway).
MASTER_KEY=
# all = API + scan worker in one service (simplest). Or run two services with MODE=api and MODE=worker.
MODE=all
PORT=8080
TRUST_PROXY=true
COOKIE_SECURE=true

# ---- Sign-in: Microsoft Entra ID (your own tenant) ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional: reject tokens without an MFA claim (configure Conditional Access to require MFA instead if possible).
ENTRA_REQUIRE_MFA=false
# The first sign-in with this e-mail becomes administrator. Remove after setup.
BOOTSTRAP_ADMIN_EMAIL=

# ---- Break glass (only when Entra sign-in is unavailable) ----
BREAKGLASS_ENABLED=false
BREAKGLASS_USERNAME=
# node apps/server/dist/cli.js hash-password
BREAKGLASS_PASSWORD_HASH=
# node apps/server/dist/cli.js gen-totp
BREAKGLASS_TOTP_SECRET=

# ---- Scanner identities of the platform (optional, enable the secret-less methods) ----
# AWS IAM user that may only sts:AssumeRole into customer roles
SCANNER_AWS_ACCESS_KEY_ID=
SCANNER_AWS_SECRET_ACCESS_KEY=
# Multi-tenant Entra app with read-only Graph application permissions (admin consent flow)
SCANNER_MS_CLIENT_ID=
SCANNER_MS_CLIENT_SECRET=

# ---- Misc ----
DEMO_MODE=false
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
LOG_LEVEL=info
