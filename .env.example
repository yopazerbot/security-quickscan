# Quickest start on your own machine: set LOCAL_MODE=true and DATABASE_URL, leave the rest empty.
# Local mode has no login, only answers on localhost and generates its own MASTER_KEY (.data/master.key).
LOCAL_MODE=false

# Only infrastructure and emergency access are configured here. Sign-in methods (email and password,
# Microsoft Entra ID), scanner identities, session timeouts, audit retention and demo mode are set in
# the app under Settings. On the first start the server log prints a one-time link to create the first administrator.

# ---- Core ----
# Hosted: public URL. Local mode: leave empty (defaults to http://localhost:8080).
APP_URL=
DATABASE_URL=postgres://user:pass@host:5432/db
# Railway Postgres over the private network does not need TLS; set true for external databases.
DATABASE_SSL=false
# 32 random bytes, base64:  node apps/server/dist/cli.js gen-master-key   (or: openssl rand -base64 32)
# Store it in Railway variables only. Losing it makes stored credentials and secret settings unreadable.
MASTER_KEY=
# all = API + scan worker in one service (simplest). Or run two services with MODE=api and MODE=worker.
MODE=all
PORT=8080
# Proxy hops in front of the app. Defaults to 1 on Railway and false elsewhere.
TRUST_PROXY=
COOKIE_SECURE=true
LOG_LEVEL=info

# ---- Break glass (recovery login, works even when every sign-in method in Settings is misconfigured) ----
BREAKGLASS_ENABLED=false
BREAKGLASS_USERNAME=
# node apps/server/dist/cli.js hash-password
BREAKGLASS_PASSWORD_HASH=
# node apps/server/dist/cli.js gen-totp
BREAKGLASS_TOTP_SECRET=

# Legacy: ENTRA_*, SCANNER_*, SESSION_IDLE_MINUTES, SESSION_MAX_HOURS, AUDIT_RETENTION_MONTHS, DEMO_MODE and
# BOOTSTRAP_ADMIN_EMAIL still work as fallbacks. Prefer Settings, and use "Import from environment" to move them.
